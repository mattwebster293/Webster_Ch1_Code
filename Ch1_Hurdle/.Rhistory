# Extract all posterior draws
M3post <- m3_HGLM_SWA$sims.list
# Extract posterior draws from jagsUI object
Mpost <- hurdle_damPres_SW$sims.list
# 1. Fixed effects for continuous part (log(SWA+1))
Mdf_scalar <- tibble(
parameter = c("alpha", "beta_damPres"),
mean = c(mean(Mpost$alpha),
mean(Mpost$beta_damPres)),
lower = c(quantile(Mpost$alpha, 0.025),
quantile(Mpost$beta_damPres, 0.025)),
upper = c(quantile(Mpost$alpha, 0.975),
quantile(Mpost$beta_damPres, 0.975))
)
# 2. Stream-level random slopes for damPresence
Mdf_stream <- map_df(1:length(Mpost$beta_stream[1,]), function(j){
tibble(
parameter = paste0("beta_stream[", j, "]"),
mean = mean(Mpost$beta_stream[, j]),
lower = quantile(Mpost$beta_stream[, j], 0.025),
upper = quantile(Mpost$beta_stream[, j], 0.975)
)
})
# 3. Year-level random slopes for damPresence
Mdf_year <- map_df(1:length(Mpost$beta_year[1,]), function(j){
tibble(
parameter = paste0("beta_year[", j, "]"),
mean = mean(Mpost$beta_year[, j]),
lower = quantile(Mpost$beta_year[, j], 0.025),
upper = quantile(Mpost$beta_year[, j], 0.975)
)
})
# 4. Event-level random slopes for damPresence
Mdf_event <- map_df(1:length(Mpost$beta_event[1,]), function(j){
tibble(
parameter = paste0("beta_event[", j, "]"),
mean = mean(Mpost$beta_event[, j]),
lower = quantile(Mpost$beta_event[, j], 0.025),
upper = quantile(Mpost$beta_event[, j], 0.975)
)
})
# Combine all summaries
Msummary_df <- bind_rows(Mdf_scalar, Mdf_stream, Mdf_year, Mdf_event)
# Pretty names for plotting
pretty_names <- c(
alpha = "Intercept (log(SWA+1))",
beta_damPres = "Global Dam Effect",
"beta_stream[1]" = "Stream Effect: Brazil",
"beta_stream[2]" = "Stream Effect: Lower Beaver",
"beta_stream[3]" = "Stream Effect: Larb",
"beta_stream[4]" = "Stream Effect: Lone Tree",
"beta_stream[5]" = "Stream Effect: Upper Beaver",
"beta_stream[6]" = "Stream Effect: Willow",
"beta_year[1]" = "Year Effect: 2019",
"beta_year[2]" = "Year Effect: 2021",
"beta_year[3]" = "Year Effect: 2023",
"beta_event[1]" = "Event: 2019 Early Aug",
"beta_event[2]" = "Event: 2019 Late Aug",
"beta_event[3]" = "Event: 2019 Early Sep",
"beta_event[4]" = "Event: 2019 Late Sep",
"beta_event[5]" = "Event: 2021 Early Aug",
"beta_event[6]" = "Event: 2021 Late Aug",
"beta_event[7]" = "Event: 2021 Early Sep",
"beta_event[8]" = "Event: 2021 Late Sep",
"beta_event[9]" = "Event: 2023 Early Aug",
"beta_event[10]" = "Event: 2023 Late Aug",
"beta_event[11]" = "Event: 2023 Early Sep",
"beta_event[12]" = "Event: 2023 Late Sep"
)
# Plot posterior means + 95% CI
ggplot(Msummary_df,
aes(x = parameter, y = mean)) +
geom_point(size = 3) +
geom_errorbar(aes(ymin = lower, ymax = upper), width = 0.1) +
geom_hline(yintercept = 0, color = "black", linewidth = 1) +
coord_flip() +
scale_x_discrete(labels = pretty_names) +
theme_minimal(base_size = 14) +
labs(
title = "Hurdle Model: Dam Presence Effects on log(SWA+1)",
subtitle = "Posterior Means and 95% Credible Intervals",
x = "Parameter",
y = "Posterior Mean"
) +
theme(axis.text.y = element_text(size = 12))
# Extract posterior draws
Mpost <- hurdle_damPres_SW$sims.list
# Helper: back-transform log(SWA+1) to raw SWA
bt <- function(x) exp(x) - 1
# 1. Fixed effects (alpha, beta_damPres)
Mdf_scalar <- tibble(
parameter = c("alpha_raw", "beta_damPres_raw"),
mean = c(mean(bt(Mpost$alpha)),
mean(bt(Mpost$alpha + Mpost$beta_damPres)) - mean(bt(Mpost$alpha))),
lower = c(quantile(bt(Mpost$alpha), 0.025),
quantile(bt(Mpost$alpha + Mpost$beta_damPres) - bt(Mpost$alpha), 0.025)),
upper = c(quantile(bt(Mpost$alpha), 0.975),
quantile(bt(Mpost$alpha + Mpost$beta_damPres) - bt(Mpost$alpha), 0.975))
)
# 2. Stream-level dam effects on raw SWA
Mdf_stream <- map_df(1:length(Mpost$beta_stream[1,]), function(j){
tibble(
parameter = paste0("beta_stream_raw[", j, "]"),
mean = mean(bt(Mpost$alpha + Mpost$beta_stream[, j]) - bt(Mpost$alpha)),
lower = quantile(bt(Mpost$alpha + Mpost$beta_stream[, j]) - bt(Mpost$alpha), 0.025),
upper = quantile(bt(Mpost$alpha + Mpost$beta_stream[, j]) - bt(Mpost$alpha), 0.975)
)
})
# 3. Year-level dam effects on raw SWA
Mdf_year <- map_df(1:length(Mpost$beta_year[1,]), function(j){
tibble(
parameter = paste0("beta_year_raw[", j, "]"),
mean = mean(bt(Mpost$alpha + Mpost$beta_year[, j]) - bt(Mpost$alpha)),
lower = quantile(bt(Mpost$alpha + Mpost$beta_year[, j]) - bt(Mpost$alpha), 0.025),
upper = quantile(bt(Mpost$alpha + Mpost$beta_year[, j]) - bt(Mpost$alpha), 0.975)
)
})
# 4. Event-level dam effects on raw SWA
Mdf_event <- map_df(1:length(Mpost$beta_event[1,]), function(j){
tibble(
parameter = paste0("beta_event_raw[", j, "]"),
mean = mean(bt(Mpost$alpha + Mpost$beta_event[, j]) - bt(Mpost$alpha)),
lower = quantile(bt(Mpost$alpha + Mpost$beta_event[, j]) - bt(Mpost$alpha), 0.025),
upper = quantile(bt(Mpost$alpha + Mpost$beta_event[, j]) - bt(Mpost$alpha), 0.975)
)
})
