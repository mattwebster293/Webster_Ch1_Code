plot_prior_post(damDen_zeta_m4_prior, damDen_zeta_m4_post, "zeta_damDen_m4")
plot_prior_post(damDen_sigBetaStream_m4_prior, damDen_sigBetaStream_m4_post, "sigma_beta_stream_m4")
