
    model{
      
      # HYPERPRIORS FOR NDVI (1/2 Normal on SDs):
    
      sigma              ~ dnorm(0,1) T(0,)
      tau                <- pow(sigma, -2)
    
      ##########################################################################
      # FIXED EFFECT PRIORS:
      
      alpha ~ dunif(-1,1)
      beta_damPres ~ dnorm(0,0.04)
    
      ##########################################################################
      
      # MAIN LOOP: NDVI
    
      for(i in 1:N){
    
        # Amount:
        y[i] ~ dnorm(mu[i], tau)
    
        mu[i] <- alpha
                    + beta_damPres * damPres[i]
      }
    
    }
    
