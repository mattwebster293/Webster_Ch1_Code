#2021
#####
# 0-BUFF: DEM derived riparian/pondable zone
ubv21_veg_0 <- read.csv("UBV21_VEGRESULTS_0BUFF.csv") %>%
mutate(TP_ID = Input_FID) %>%
select(stream,
TP_ID,
Shape_Area_0,
NDVI_veg21_0,
Veg_area_veg21_0)
# 10-BUFF: ^^ + 10-m planar buffer
ubv21_veg_10 <- read.csv("UBV21_VEGRESULTS_10BUFF.csv") %>%
mutate(TP_ID = Input_FID) %>%
select(stream,
TP_ID,
Shape_Area_10,
NDVI_veg21_10,
Veg_area_veg21_10)
# 20-BUFF
ubv21_veg_20 <- read.csv("UBV21_VEGRESULTS_20BUFF.csv") %>%
mutate(TP_ID = Input_FID) %>%
select(stream,
TP_ID,
Shape_Area_20,
NDVI_veg21_20,
Veg_area_veg21_20)
# 30-BUFF
ubv21_veg_30 <- read.csv("UBV21_VEGRESULTS_30BUFF.csv") %>%
mutate(TP_ID = Input_FID) %>%
select(stream,
TP_ID,
Shape_Area_30,
NDVI_veg21_30,
Veg_area_veg21_30)
ubv21_veg <- ubv21_veg_0 %>%
left_join(ubv21_veg_10,
by = c("stream","TP_ID")) %>%
left_join(ubv21_veg_20,
by = c("stream","TP_ID")) %>%
left_join(ubv21_veg_30,
by = c("stream","TP_ID")) %>%
mutate(stream = "UBV") %>%
group_by(TP_ID) %>%
slice_max(order_by = Shape_Area_0, n = 1, with_ties = FALSE) %>%
ungroup()
